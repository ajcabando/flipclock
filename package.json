{
  "name": "flipclock",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "description": "A modern macOS-style flip clock web app. Resizable, multi-window ready, Tauri packaging ready.",
  "author": "Milds3v3n",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "dist:mac": "tauri build",
    "dist:mac:universal": "tauri build --target universal-apple-darwin",
    "dist:mac:dir": "tauri build --no-bundle"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.4"
  }
}
