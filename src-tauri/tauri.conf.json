{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flip Clock",
  "version": "1.0.1",
  "identifier": "com.milds3v3n.flipclock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Flip Clock",
        "label": "main",
        "width": 540,
        "height": 360,
        "minWidth": 220,
        "minHeight": 140,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
